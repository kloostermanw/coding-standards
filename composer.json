{
    "name": "kloostermanw/coding-standards",
    "description": "Shared php-cs-fixer, phpstan/larastan and rector configuration for php apps.",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.4",
        "friendsofphp/php-cs-fixer": "^3.86",
        "larastan/larastan": "^3.1",
        "phpstan/phpstan-phpunit": "^2.0",
        "rector/rector": "^2.5"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Kloostermanw\\CodingStandards\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Kloostermanw\\CodingStandards\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true
        },
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
